{
  "name": "sig-p4b-signup",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [
    // Sign-ups (sub:<email>) and per-IP rate-limit counters (rl:<ip>:<hour>).
    // This id belongs to the current deployment's Cloudflare account; worker/setup.sh replaces it.
    { "binding": "SIGNUPS", "id": "78a345f4c750428890b6a12a9283326b" },
    { "binding": "MENTIONS", "id": "9214a86adf814e4e896b69a2c72cd5e7" }   // shared with site/: the blyg's Webmentions
  ],
  "vars": {
    "SITE": "https://protocolsforbusiness.com/",
    "ALLOWED_ORIGINS": "https://protocolsforbusiness.com,https://www.protocolsforbusiness.com,https://npc.here.now,https://scarlet-rapids-8mbp.here.now,http://localhost:8000,http://127.0.0.1:8000"
  },
  "triggers": { "crons": ["0 16 * * 5"] },   // Fridays 16:00 UTC: the weekly blyg digest
  "observability": { "enabled": true }
  // Secret (set with `npx wrangler secret put EXPORT_SECRET`, never commit):
  //   EXPORT_SECRET — gates /export.csv and signs unsubscribe links
}
