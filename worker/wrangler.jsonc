{
  "name": "sig-p4b-signup",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [
    // Sign-ups (sub:<email>) and per-IP rate-limit counters (rl:<ip>:<hour>).
    { "binding": "SIGNUPS", "id": "78a345f4c750428890b6a12a9283326b" }
  ],
  "observability": { "enabled": true }
  // Secret (set with `npx wrangler secret put EXPORT_SECRET`, never commit):
  //   EXPORT_SECRET — gates /export.csv and signs unsubscribe links
}
